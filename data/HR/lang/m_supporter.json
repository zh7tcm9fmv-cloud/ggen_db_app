  {
    "id": 160800001001000150,
    "value": "맞지도 않고 사람 구실 하는 녀석은 이 세상에 없다!"
  },
  {
    "id": 160800001001000250,
    "value": "난 아무로가 싸우지 않았다면 예전에 죽었어…."
  },
  {
    "id": 160800001001000750,
    "value": "우후후, 당신은 아무것도 못 느꼈어…?"
  },
  {
    "id": 160800001013000150,
    "value": "나는 거물이 될 거야! 가만히 당할 수는 없지!"
  },
  {
    "id": 160800001031000150,
    "value": "더 이상 너를 사랑하지 않을 거야.\n그래야 가서 죽으라고 명령 내릴 수 있으니까…."
  },
  {
    "id": 160800001031000250,
    "value": "그냥 마구 쏘면 된다!\n쏴라!"
  },
  {
    "id": 160800001060000150,
    "value": "경계를 늦추지 마라! 방심하다가는 단숨에 당한다!"
  },
  {
    "id": 160800001060000250,
    "value": "이 시마의 먹이를 가로채겠다는 거냐!"
  },
  {
    "id": 160800001080000150,
    "value": "지금은 싸울 수밖에 없으니까…나도 가만히 있을 순 없어."
  },
  {
    "id": 160800001080000250,
    "value": "에마 중위님은 이 래디시의 꽃이니\n무슨 일이 있어도 이 전함으로 맞이하러 가겠어."
  },
  {
    "id": 160800001080000550,
    "value": "눈을 떠.\n그러면 예전과 똑같아질 거야."
  },
  {
    "id": 160800001080000650,
    "value": "명령은 똑바로 듣고 실행해! 나 참!"
  },
  {
    "id": 160800001095000150,
    "value": "좋았어! 전원 위치로! 넬 아가마 발진!"
  },
  {
    "id": 160800001095000350,
    "value": "대의를 방해하는 어리석은 자는 내 앞에서 사라져라!"
  },
  {
    "id": 160800001110000150,
    "value": "론도 벨은 독자적으로 행동한다! 가자!"
  },
  {
    "id": 160800001110000350,
    "value": "대령님… 당신의 작전은 완벽했습니다."
  },
  {
    "id": 160800001125000250,
    "value": "제군의 건투를 기대한다!"
  },
  {
    "id": 160800001125000450,
    "value": "내게는 자비 가문의 피를 이어받은 자로서의\n책임과 의무가 있다!"
  },
  {
    "id": 160800001144000150,
    "value": "누가 실패작이라는 거냐! 누가 미완성품이라는 거냐!\n나를 무시하는 놈은…!"
  },
  {
    "id": 160800001150000150,
    "value": "마프티의 방식은 잘못됐어."
  },
  {
    "id": 160800001162000150,
    "value": "먼저 눈앞의 쓰레기를 청소해야겠군…!"
  },
  {
    "id": 160800001175000150,
    "value": "진 자하남 각하께서도\n그렇게 생각하신다면…!"
  },
  {
    "id": 160800001200000150,
    "value": "나는… 당신의 파트너야!\n그러니까 같이 싸울래…!"
  },
  {
    "id": 160800001200000350,
    "value": "후하하하하하…!"
  },
  {
    "id": 160800001210000150,
    "value": "평화는 전쟁을 통해 만들어지는 게 아니에요."
  },
  {
    "id": 160800001210000350,
    "value": "전장을 너무 얕봤군 !"
  },
  {
    "id": 160800001210000550,
    "value": "나는 끝을 내기 위해 싸우고 있다!"
  },
  {
    "id": 160800001230000150,
    "value": "당신에게 힘을…."
  },
  {
    "id": 160800001230000350,
    "value": "뉴타입은 정말로 인간의 미래를 만드는 건가…?\n그 진실을 지켜보고 싶은 것이다."
  },
  {
    "id": 160800001300000150,
    "value": "로엔그린… 조준!"
  },
  {
    "id": 160800001300000450,
    "value": "마음만으로도… 힘만으로도 안 되니까요. 그렇기에…."
  },
  {
    "id": 160800001300000550,
    "value": "가희의 배에 온 걸 환영한다.\n앤드류 발트펠드다."
  },
  {
    "id": 160800001300000650,
    "value": "난폭한 건 좋지 않죠."
  },
  {
    "id": 160800001305000250,
    "value": "통신에 정비! 뭐든지 맡겨만 주세요!"
  },
  {
    "id": 160800001305000350,
    "value": "-"
  },
  {
    "id": 160800001330000250,
    "value": "탄호이저 기동, 전방의 적을 조준…!\n발사아아아아!!"
  },
  {
    "id": 160800001330000450,
    "value": "너무 강한 힘은 분쟁을 부를 것이다!\n그러니까!"
  },
  {
    "id": 160800001370000150,
    "value": "우리 솔레스탈 빙의 데뷔야."
  },
  {
    "id": 160800001370000450,
    "value": "싸움으론 아무것도 만들어낼 수 없어… 잃기만 할 뿐이야!"
  },
  {
    "id": 160800001370000550,
    "value": "다시 한번 세계를 바꾸죠! 미래를 위해서!"
  },
  {
    "id": 160800001376000150,
    "value": "어떤 일이든 쉐릴린에게 맡겨줘!"
  },
  {
    "id": 160800001400000150,
    "value": "나는 복수라는 망령에 사로잡혔다!"
  },
  {
    "id": 160800001430000150,
    "value": "…가는 거야. 우리 다 같이!"
  },
  {
    "id": 160800001430000350,
    "value": "저를 믿어 주는 사람들을 위해\n저는 제 책임을 다해야 해요."
  },
  {
    "id": 160800001430000450,
    "value": "우리 걀라르호른은, 세계의 질서를 지키기 위해 존재한다."
  },
  {
    "id": 160800001430000550,
    "value": "나, 나도 어쨌든 열심히 해야지!"
  },
  {
    "id": 160800001501000150,
    "value": "나도 소중한 걸 잃고 싶지 않아."
  },
  {
    "id": 160800001501000450,
    "value": "드디어 열리는 거야. 너를 위한 세상이…."
  },
  {
    "id": 160800001501000550,
    "value": "입회인은 제타크 기숙사장.\n라우더 닐이 맡는다."
  },
  {
    "id": 160800001705000150,
    "value": "'힘에는 마법, 마법에는 힘'. 이것이 싸움의 기본이다."
  },
  {
    "id": 160800001705000350,
    "value": "반드시 이 땅에 평화를!"
  }
]