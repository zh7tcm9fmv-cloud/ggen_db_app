  {
    "id": 160900001001000150,
    "value": "무엇을 했느냐에 따라 인간의 가치가 결정되지."
  },
  {
    "id": 160900001001000250,
    "value": "모든 승무원은 주위를 경계하라!"
  },
  {
    "id": 160900001001000450,
    "value": "-"
  },
  {
    "id": 160900001001000550,
    "value": "-"
  },
  {
    "id": 160900001001000650,
    "value": "-"
  },
  {
    "id": 160900001001000750,
    "value": "그만두세요 ! 인간은 싸우기 위한 존재가 아니잖아요!?"
  },
  {
    "id": 160900001013000150,
    "value": "이봐! 멍하니 있으면 해치워 버린다!"
  },
  {
    "id": 160900001022000150,
    "value": "-"
  },
  {
    "id": 160900001031000150,
    "value": "부탁이야…! 모두 살아서 돌아와 줘!"
  },
  {
    "id": 160900001031000250,
    "value": "잔말 말고 빨리 길을 터라!"
  },
  {
    "id": 160900001055000360,
    "value": "-"
  },
  {
    "id": 160900001060000150,
    "value": "기관 전속! 놓쳐선 안 된다!"
  },
  {
    "id": 160900001060000250,
    "value": "난 성질이 급하다고! 빨리 끝내버리겠다!!"
  },
  {
    "id": 160900001080000150,
    "value": "나, 나… 방해가 되진 않을 거야!!"
  },
  {
    "id": 160900001080000250,
    "value": "더 이상 적의 뜻대로 흘러가게 두지 마라!"
  },
  {
    "id": 160900001080000450,
    "value": "-"
  },
  {
    "id": 160900001080000550,
    "value": "소용없어! 볼썽사나운 짓은 그만둬!"
  },
  {
    "id": 160900001080000650,
    "value": "전후 처리는 평화로워진 다음에나 하는 일이다!"
  },
  {
    "id": 160900001095000150,
    "value": "나도 조금이나마\n멋진 모습을 보여줘야지!　"
  },
  {
    "id": 160900001095000250,
    "value": "-"
  },
  {
    "id": 160900001095000350,
    "value": "나의 의지가 네놈을 장사 지낼 것이다!"
  },
  {
    "id": 160900001095000450,
    "value": "-"
  },
  {
    "id": 160900001095000560,
    "value": "-"
  },
  {
    "id": 160900001110000150,
    "value": "미안하지만 모두의 목숨을 걸어다오."
  },
  {
    "id": 160900001110000250,
    "value": "-"
  },
  {
    "id": 160900001110000350,
    "value": "너무 얕보지 마시죠…!"
  },
  {
    "id": 160900001125000150,
    "value": "-"
  },
  {
    "id": 160900001125000250,
    "value": "지구권이 다시 소란에 휘말리는 건 사양하겠어!"
  },
  {
    "id": 160900001125000350,
    "value": "-"
  },
  {
    "id": 160900001125000450,
    "value": "같은 잘못이 반복되려 한다면…!"
  },
  {
    "id": 160900001144000150,
    "value": "쏜단 말이지, 이걸!"
  },
  {
    "id": 160900001150000150,
    "value": "그딴 가짜, 해치워 버려!"
  },
  {
    "id": 160900001150000260,
    "value": "-"
  },
  {
    "id": 160900001162000150,
    "value": "제 주제도 모르다니 정말이지 구제 불능이로군…!"
  },
  {
    "id": 160900001175000150,
    "value": "끈질긴 녀석! 이 이상 접근시키지 마라!"
  },
  {
    "id": 160900001200000150,
    "value": "나도 더는 가만히 보고 있을 순 없어…！"
  },
  {
    "id": 160900001200000250,
    "value": "-"
  },
  {
    "id": 160900001200000350,
    "value": "후후후후후…!"
  },
  {
    "id": 160900001210000150,
    "value": "전쟁 같은 걸 누가 바란다는 거죠…!?"
  },
  {
    "id": 160900001210000250,
    "value": "-"
  },
  {
    "id": 160900001210000350,
    "value": "실전의 혹독함이란 것을 가르쳐주지… !"
  },
  {
    "id": 160900001210000460,
    "value": "-"
  },
  {
    "id": 160900001210000550,
    "value": "이건 전쟁이다! 평화를 바랐기에 일어난!"
  },
  {
    "id": 160900001230000150,
    "value": "미래를 슬픈 시대로 만들고 싶지 않으니까…！"
  },
  {
    "id": 160900001230000250,
    "value": "-"
  },
  {
    "id": 160900001230000350,
    "value": "나는, 저 비극을 반복하고 싶지 않은 것이다… !"
  },
  {
    "id": 160900001300000150,
    "value": "설령 무모할지라도, 여길 넘어서야만 해…！"
  },
  {
    "id": 160900001300000250,
    "value": "-"
  },
  {
    "id": 160900001300000350,
    "value": "-"
  },
  {
    "id": 160900001300000450,
    "value": "저도 이미 각오는 되어 있습니다…！"
  },
  {
    "id": 160900001300000550,
    "value": "이거야 원… 물러나 주면 고맙겠는데!"
  },
  {
    "id": 160900001300000650,
    "value": "하하하하하…! 해냈군!"
  },
  {
    "id": 160900001300000760,
    "value": "-"
  },
  {
    "id": 160900001305000150,
    "value": "-"
  },
  {
    "id": 160900001305000250,
    "value": "주어진 일에 걸맞은 능력은 갖추고 있어요!"
  },
  {
    "id": 160900001305000350,
    "value": "-"
  },
  {
    "id": 160900001330000150,
    "value": "-"
  },
  {
    "id": 160900001330000250,
    "value": "알겠어? …지금이 고비야 !"
  },
  {
    "id": 160900001330000450,
    "value": "그래선 안돼 ! 그저 서로 죽이려 드는 건… !"
  },
  {
    "id": 160900001370000150,
    "value": "세계의 적이 된다. 그건 악행이지만…！"
  },
  {
    "id": 160900001370000250,
    "value": "-"
  },
  {
    "id": 160900001370000350,
    "value": "-"
  },
  {
    "id": 160900001370000450,
    "value": "내게도 뭔가 할 수 있는 일이 있을 거야…!"
  },
  {
    "id": 160900001370000550,
    "value": "우리는 이대로 강행 돌파합니다 !"
  },
  {
    "id": 160900001376000150,
    "value": "나도 서포트 할게!"
  },
  {
    "id": 160900001400000150,
    "value": "몇 명이 있어도 복수를 방해하진 못한다!"
  },
  {
    "id": 160900001430000150,
    "value": "우주 쥐의 진가 발휘라는 거다！"
  },
  {
    "id": 160900001430000250,
    "value": "-"
  },
  {
    "id": 160900001430000350,
    "value": "내가 할 수 있는 일은 적어. 그렇다 해도…！"
  },
  {
    "id": 160900001430000450,
    "value": "짐승을 잡는 데는, 어울리는 방법이란 게 있지."
  },
  {
    "id": 160900001430000550,
    "value": "내가 할 수 있는 일을, 조금이라도 해야 해!"
  },
  {
    "id": 160900001431000150,
    "value": "-"
  },
  {
    "id": 160900001501000150,
    "value": "이건 내 싸움이라고!"
  },
  {
    "id": 160900001501000250,
    "value": "-"
  },
  {
    "id": 160900001501000450,
    "value": "시작하자, 에리."
  },
  {
    "id": 160900001501000550,
    "value": "픽스 릴리스!"
  },
  {
    "id": 160900001705000150,
    "value": "'힘에는 마법, 마법에는 힘'. 이것이 싸움의 기본이다."
  },
  {
    "id": 160900001705000260,
    "value": "-"
  },
  {
    "id": 160900001705000350,
    "value": "힘에는 기술, 기술에는 마법, 마법에는 힘이다!"
  },
