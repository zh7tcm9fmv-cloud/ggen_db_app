[
  {
    "id": 100811001000201011,
    "value": "還在努力嗎？\n喔喔，真受不了……"
  },
  {
    "id": 100811001000301011,
    "value": "我也不能被阿寶比下去！"
  },
  {
    "id": 100811080000701011,
    "value": "我要參與任務。"
  },
  {
    "id": 100811080000701012,
    "value": "我是花·園麗，請多指教。"
  },
  {
    "id": 100811080002700011,
    "value": "人還是必須要接受"
  },
  {
    "id": 100811080002700012,
    "value": "妥善的引導才行。"
  },
  {
    "id": 100811095000101011,
    "value": "我不出動就無法開始啊！"
  },
  {
    "id": 100811095000101012,
    "value": "捷度·艾斯圖，出動！"
  },
  {
    "id": 100811095001800011,
    "value": "呵呵呵，我會遵守約定的。"
  },
  {
    "id": 100811095001800012,
    "value": "將我們的力量烙印在眼底吧！"
  },
  {
    "id": 100811210000100011,
    "value": "生命並不值錢，"
  },
  {
    "id": 100811210000100012,
    "value": "尤其是我這條命……"
  },
  {
    "id": 100811210002300011,
    "value": "即使是簡單的任務，"
  },
  {
    "id": 100811210002300012,
    "value": "也不可以鬆懈。"
  },
  {
    "id": 100811300002001011,
    "value": "我這種人也是有想要保護的東西！"
  },
  {
    "id": 100811304000100011,
    "value": "讓你見識一下實力的差距！"
  },
  {
    "id": 100811850000400011,
    "value": "居然自己跑來見閻王…！"
  },
  {
    "id": 100811850000400012,
    "value": "就算是瞬間的破綻，在戰場上也會要命！"
  },
  {
    "id": 100811850000900011,
    "value": "我來支援了！"
  },
  {
    "id": 100811850000900012,
    "value": "大家！……小心！"
  },
  {
    "id": 101611370000101011,
    "value": "用武力根絕戰爭！\n高達會實踐這一切！"
  },
  {
    "id": 101611370000101012,
    "value": "你的扭曲…就由我來斬斷！"
  },
  {
    "id": 101611370000402011,
    "value": "無論遇上什麼狀況，我們都不會停止武力介入！"
  },
  {
    "id": 101611370000402012,
    "value": "在這裡斷絕未來的禍根！"
  },
  {
    "id": 101611501000401011,
    "value": "讓我來確認你的實力。"
  },
  {
    "id": 101611501000401012,
    "value": "那就開始吧。"
  },
  {
    "id": 101611501000501011,
    "value": "我不會再猶豫了。"
  },
  {
    "id": 101611501000501012,
    "value": "別恨我喔。"
  }
